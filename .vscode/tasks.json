{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Rebuild and Run",
			"type": "shell",
			"command": "bash",
			"args": [
				"-c",
				"pkill -f bejeweled-bot || true; cmake --build builds/msbuild-vcpkg --config Debug && ./builds/msbuild-vcpkg/Debug/bejeweled-bot.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
		}
	],
}