{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "$pen{triplet}"
      },
      "environment": {
        "triplet": "x64-windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": ["Windows"]
        }
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "description": "Debug build for x64 with vcpkg dynamic linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows"
      }
    },
    {
      "name": "x64-debug-static",
      "displayName": "x64 Debug Static",
      "description": "Debug build for x64 with vcpkg static linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows-static"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "description": "Release build for x64 with vcpkg dynamic linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows"
      }
    },
    {
      "name": "x64-release-static",
      "displayName": "x64 Release Static",
      "description": "Release build for x64 with vcpkg static linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows-static"
      }
    },
    {
      "name": "x64-release-debug",
      "displayName": "x64 RelWithDebInfo",
      "description": "RelWithDebInfo build for x64 with vcpkg dynamic linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows"
      }
    },
    {
      "name": "x64-release-debug-static",
      "displayName": "x64 RelWithDebInfo Static",
      "description": "RelWithDebInfo build for x64 with vcpkg static linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows-static"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-debug-static",
      "configurePreset": "x64-debug-static",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-release-static",
      "configurePreset": "x64-release-static",
      "configuration": "Release"
    },
    {
      "name": "x64-release-debug",
      "configurePreset": "x64-release-debug",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "x64-release-debug-static",
      "configurePreset": "x64-release-debug-static",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-release-debug",
      "configurePreset": "x64-release-debug",
      "configuration": "RelWithDebInfo"
    }
  ]
}
