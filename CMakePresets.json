{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "x64-Debug",
      "displayName": "x64 Debug (Dynamic)",
      "description": "Debug build with dynamic linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows"
      }
    },
    {
      "name": "x64-Debug-Static",
      "displayName": "x64 Debug (Static)",
      "description": "Debug build with static linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows-static"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "x64 Release (Dynamic)",
      "description": "Release build with dynamic linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows"
      }
    },
    {
      "name": "x64-Release-Static",
      "displayName": "x64 Release (Static)",
      "description": "Release build with static linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows-static"
      }
    },
    {
      "name": "x64-RelWithDebInfo",
      "displayName": "x64 RelWithDebInfo (Dynamic)",
      "description": "Release with Debug Info build with dynamic linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows"
      }
    },
    {
      "name": "x64-RelWithDebInfo-Static",
      "displayName": "x64 RelWithDebInfo (Static)",
      "description": "Release with Debug Info build with static linking",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed-x64-windows-static"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-Debug",
      "configurePreset": "x64-Debug"
    },
    {
      "name": "x64-Debug-Static",
      "configurePreset": "x64-Debug-Static"
    },
    {
      "name": "x64-Release",
      "configurePreset": "x64-Release"
    },
    {
      "name": "x64-Release-Static",
      "configurePreset": "x64-Release-Static"
    },
    {
      "name": "x64-RelWithDebInfo",
      "configurePreset": "x64-RelWithDebInfo"
    },
    {
      "name": "x64-RelWithDebInfo-Static",
      "configurePreset": "x64-RelWithDebInfo-Static"
    }
  ],
  "testPresets": [
    {
      "name": "x64-Debug",
      "configurePreset": "x64-Debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-Release",
      "configurePreset": "x64-Release",
      "configuration": "Release"
    },
    {
      "name": "x64-RelWithDebInfo",
      "configurePreset": "x64-RelWithDebInfo",
      "configuration": "RelWithDebInfo"
    }
  ]
}
