{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "clangcl-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "ClangCL"
    },
    {
      "name": "dynamic-base",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed"
      }
    },
    {
      "name": "static-base",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "dynamic-clang-debug",
      "displayName": "Dynamic - Clang - Debug",
      "inherits": ["clangcl-base", "dynamic-base", "debug-base"]
    },
    {
      "name": "dynamic-clang-release",
      "displayName": "Dynamic - Clang - Release",
      "inherits": ["clangcl-base", "dynamic-base", "release-base"]
    },
    {
      "name": "dynamic-clang-relwithdebinfo",
      "displayName": "Dynamic - Clang - RelWithDebInfo",
      "inherits": ["clangcl-base", "dynamic-base", "relwithdebinfo-base"]
    },
    {
      "name": "dynamic-msvc-debug",
      "displayName": "Dynamic - MSVC - Debug",
      "inherits": ["msvc-base", "dynamic-base", "debug-base"]
    },
    {
      "name": "dynamic-msvc-release",
      "displayName": "Dynamic - MSVC - Release",
      "inherits": ["msvc-base", "dynamic-base", "release-base"]
    },
    {
      "name": "dynamic-msvc-relwithdebinfo",
      "displayName": "Dynamic - MSVC - RelWithDebInfo",
      "inherits": ["msvc-base", "dynamic-base", "relwithdebinfo-base"]
    },
    {
      "name": "static-clang-debug",
      "displayName": "Static - Clang - Debug",
      "inherits": ["clangcl-base", "static-base", "debug-base"]
    },
    {
      "name": "static-clang-release",
      "displayName": "Static - Clang - Release",
      "inherits": ["clangcl-base", "static-base", "release-base"]
    },
    {
      "name": "static-clang-relwithdebinfo",
      "displayName": "Static - Clang - RelWithDebInfo",
      "inherits": ["clangcl-base", "static-base", "relwithdebinfo-base"]
    },
    {
      "name": "static-msvc-debug",
      "displayName": "Static - MSVC - Debug",
      "inherits": ["msvc-base", "static-base", "debug-base"]
    },
    {
      "name": "static-msvc-release",
      "displayName": "Static - MSVC - Release",
      "inherits": ["msvc-base", "static-base", "release-base"]
    },
    {
      "name": "static-msvc-relwithdebinfo",
      "displayName": "Static - MSVC - RelWithDebInfo",
      "inherits": ["msvc-base", "static-base", "relwithdebinfo-base"]
    }
  ],
  "buildPresets": [
    {
      "name": "dynamic-clang-debug",
      "configurePreset": "dynamic-clang-debug",
      "configuration": "Debug"
    },
    {
      "name": "dynamic-clang-release",
      "configurePreset": "dynamic-clang-release",
      "configuration": "Release"
    },
    {
      "name": "dynamic-clang-relwithdebinfo",
      "configurePreset": "dynamic-clang-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "dynamic-msvc-debug",
      "configurePreset": "dynamic-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "dynamic-msvc-release",
      "configurePreset": "dynamic-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "dynamic-msvc-relwithdebinfo",
      "configurePreset": "dynamic-msvc-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "static-clang-debug",
      "configurePreset": "static-clang-debug",
      "configuration": "Debug"
    },
    {
      "name": "static-clang-release",
      "configurePreset": "static-clang-release",
      "configuration": "Release"
    },
    {
      "name": "static-clang-relwithdebinfo",
      "configurePreset": "static-clang-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "static-msvc-debug",
      "configurePreset": "static-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "static-msvc-release",
      "configurePreset": "static-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "static-msvc-relwithdebinfo",
      "configurePreset": "static-msvc-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "dynamic-msvc-debug",
      "configurePreset": "dynamic-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "dynamic-msvc-release",
      "configurePreset": "dynamic-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "dynamic-msvc-relwithdebinfo",
      "configurePreset": "dynamic-msvc-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    }
  ]
}